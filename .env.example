# ──────────────────────────────────────────────────────────────────────────
# Daftar (دفتر) — environment configuration
# Copy this file to .env in apps/api (server) and apps/web (client) as noted,
# or use a single root .env with a process manager that loads it into both.
# ──────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=دفتر
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000

# ── Database (PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=postgres://daftar:daftar_dev_password@localhost:5432/daftar_dev

# ── Auth / Sessions ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ── Storage ──────────────────────────────────────────────────────────────
# Provider: "local" | "s3" | "r2" | "supabase"
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads
STORAGE_MAX_UPLOAD_MB=8

# S3 / R2 / Supabase-compatible (only needed when STORAGE_PROVIDER != local)
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

# ── Payments ─────────────────────────────────────────────────────────────
# Provider: "mock" (default, simulates a payment gateway end-to-end for
# local/demo use) | "stripe" (requires keys below)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_MESSAGES=5
RATE_LIMIT_MAX_AUTH=10

# ── Email (transactional, optional) ─────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@daftar.app
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ── Frontend-only (Vite, must be prefixed VITE_) ────────────────────────
VITE_API_URL=http://localhost:4000
VITE_APP_URL=http://localhost:5173
VITE_DEFAULT_LOCALE=ar
VITE_STRIPE_PUBLISHABLE_KEY=
