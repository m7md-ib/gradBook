{
  "name": "daftar",
  "version": "0.1.0",
  "private": true,
  "description": "دفتر (Daftar) — Interactive digital graduation guestbook platform",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "predev": "pnpm --filter @daftar/shared run build",
    "dev": "pnpm --parallel --filter @daftar/shared --filter ./apps/* run dev",
    "dev:web": "pnpm --filter @daftar/web run dev",
    "dev:api": "pnpm --filter @daftar/api run dev",
    "build": "pnpm --filter @daftar/shared run build && pnpm --filter @daftar/api run build && pnpm --filter @daftar/web run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @daftar/web run test:e2e",
    "db:generate": "pnpm --filter @daftar/api run db:generate",
    "db:migrate": "pnpm --filter @daftar/api run db:migrate",
    "db:seed": "pnpm --filter @daftar/api run db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
