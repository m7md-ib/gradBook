NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

DATABASE_URL=postgres://daftar:daftar_dev_password@localhost:5432/daftar_dev

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads
STORAGE_MAX_UPLOAD_MB=8

STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_MESSAGES=5
RATE_LIMIT_MAX_AUTH=10

EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@daftar.app
